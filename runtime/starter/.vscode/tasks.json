{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build and run", "type": "shell",
      "command": "clang++ -std=c++17 main.cpp -o main && ./main",
      "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$gcc"
    },
    { "label": "Python: run", "type": "shell", "command": "python hello.py", "problemMatcher": [] },
    { "label": "Java: build and run", "type": "shell", "command": "javac Hello.java && java Hello", "problemMatcher": "$javac" },
    { "label": "Web: preview on port 3000", "type": "shell", "command": "python -m http.server 3000 --bind 127.0.0.1", "problemMatcher": [] }
  ]
}
